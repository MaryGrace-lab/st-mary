// ──────────────────────────────────────────────
// Prisma Schema – St. Mary Catholic Church
// ──────────────────────────────────────────────

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum DonationStatus {
  PENDING
  ACKNOWLEDGED
}

model Homily {
  id          String   @id @default(uuid())
  title       String
  description String?
  youtubeId   String
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  featured    Boolean  @default(false)

  @@index([publishedAt])
}

model DailyReading {
  id                 String   @id @default(uuid())
  date               DateTime @unique
  liturgicalDay      String?
  firstReading       String
  firstReadingTitle  String
  responsorialPsalm  String
  responsorialTitle  String
  secondReading      String?
  secondReadingTitle String?
  gospelAcclamation  String
  gospelAcclamationVerse String?
  gospel             String
  gospelTitle        String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([date])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model MassBooking {
  id              String        @id @default(uuid())
  name            String
  email           String?
  phone           String
  intentionType   String
  location        String
  intentionNote   String?
  bookDate        DateTime
  massTime        String?
  namesToPrayFor  String?
  additionalInfo  String?
  amount          Float
  consent         Boolean
  status          BookingStatus @default(PENDING)
  reference       String        @unique
  paymentInitiated Boolean      @default(false)   // ← added
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([bookDate])
  @@index([paymentInitiated])
}

model Donation {
  id          String         @id @default(uuid())
  name        String
  email       String?
  amount      Float
  purpose     String?
  message     String?
  status      DonationStatus @default(PENDING)
  createdAt   DateTime       @default(now())

  @@index([status])
  @@index([createdAt])
}

model RateLimit {
  id        String   @id @default(uuid())
  ip        String
  endpoint  String
  timestamp DateTime @default(now())

  @@index([ip, endpoint, timestamp])
}